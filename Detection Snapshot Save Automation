alias: Detection Snapshot Save
triggers:
  - entity_id:
      - binary_sensor.demo_side_gate_camera_person
      - binary_sensor.demo_patio_camera_person
      - binary_sensor.demo_backyard_camera_person
      - binary_sensor.demo_garage_camera_person
      - binary_sensor.demo_garage_camera_vehicle
      - binary_sensor.demo_driveway_camera_person
      - binary_sensor.demo_driveway_camera_vehicle_entry
      - binary_sensor.demo_driveway_camera_vehicle_exit
      - binary_sensor.demo_street_camera_person
      - binary_sensor.demo_street_camera_vehicle
    to: 'on'
    trigger: state
conditions:
  - condition: template
    value_template: '{{ cam != '''' }}'
actions:
  - data:
      cam: '{{ cam }}'
    action: shell_command.detection_dir
  - target:
      entity_id: camera.{{ cam }}
    data:
      filename: /media/detections/{{ cam }}/{{ now().strftime('%Y%m%d_%H%M%S') }}.jpg
    action: camera.snapshot
mode: queued
max: 10
variables:
  cam: |-
    {% set m = {
      'binary_sensor.demo_side_gate_camera_person': 'demo_side_gate',
      'binary_sensor.demo_patio_camera_person': 'demo_patio',
      'binary_sensor.demo_backyard_camera_person': 'demo_backyard',
      'binary_sensor.demo_garage_camera_person': 'demo_garage',
      'binary_sensor.demo_garage_camera_vehicle': 'demo_garage',
      'binary_sensor.demo_street_camera_person': 'demo_street',
      'binary_sensor.demo_street_camera_vehicle': 'demo_street',
      'binary_sensor.demo_driveway_camera_person': 'demo_driveway',
      'binary_sensor.demo_driveway_camera_vehicle_entry': 'demo_driveway',
      'binary_sensor.demo_driveway_camera_vehicle_exit': 'demo_driveway'
    } %} {{ m.get(trigger.entity_id, '') }}
