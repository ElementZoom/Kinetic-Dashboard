alias: Detection Snapshot Save
triggers:
  - entity_id:
      - binary_sensor.right_walkway_camera_person
      - binary_sensor.left_walkway_camera_person
      - binary_sensor.right_backyard_camera_person
      - binary_sensor.garage_camera_person
      - binary_sensor.garage_camera_vehicle
      - binary_sensor.driveway_cameras_person_detection
      - binary_sensor.right_driveway_camera_crossline_vehicle_detection_entry
      - binary_sensor.right_driveway_camera_crossline_vehicle_detection_exit
      - binary_sensor.road_camera_person
      - binary_sensor.road_camera_vehicle
    to: 'on'
    trigger: state
conditions:
  - condition: template
    value_template: '{{ cam != '''' }}'
actions:
  - data:
      cam: '{{ cam }}'
    action: shell_command.detection_dir
  - target:
      entity_id: camera.{{ cam }}
    data:
      filename: /media/detections/{{ cam }}/{{ now().strftime('%Y%m%d_%H%M%S') }}.jpg
    action: camera.snapshot
mode: queued
max: 10
variables:
  cam: |-
    {% set m = {
      'binary_sensor.right_walkway_camera_person': 'right_walkway_camera_clear',
      'binary_sensor.left_walkway_camera_person': 'left_walkway_camera_fluent',
      'binary_sensor.right_backyard_camera_person': 'right_backyard_camera_clear',
      'binary_sensor.garage_camera_person': 'garage_camera_clear',
      'binary_sensor.garage_camera_vehicle': 'garage_camera_clear',
      'binary_sensor.road_camera_person': 'road_camera_clear',
      'binary_sensor.road_camera_vehicle': 'road_camera_clear',
      'binary_sensor.driveway_cameras_person_detection': 'right_driveway_camera_clear',
      'binary_sensor.right_driveway_camera_crossline_vehicle_detection_entry': 'right_driveway_camera_clear',
      'binary_sensor.right_driveway_camera_crossline_vehicle_detection_exit': 'right_driveway_camera_clear'
    } %} {{ m.get(trigger.entity_id, '') }}
